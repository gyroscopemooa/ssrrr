# Copy to .env.worker for the separate Node worker. Never commit that file.
WORKER_SITE_URL=https://www.ssrrr.net
WORKER_TOKEN=
# Optional dedicated token used only by the external ChatGPT MCP connector.
MCP_INGEST_TOKEN=
WORKER_ID=secretagit-worker-1
# Only needed when the deployed Sites URL is owner-private.
SITES_DISPATCHER_TOKEN=
WORKER_TEMP_DIR=.worker-tmp
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional VM relay: opens ChatGPT task links in a dedicated persistent Edge profile.
CHATGPT_RELAY_ENABLED=false
CHATGPT_BROWSER_CHANNEL=msedge
CHATGPT_PROFILE_DIR=.worker-runtime/chatgpt-profile
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Optional binary overrides; bundled npm binaries are used by default.
FFMPEG_PATH=
FFPROBE_PATH=
# Web runtime values (Sites environment settings, or local .dev.vars):
ADMIN_EMAIL=
METRICS_SALT=
SITE_NAME=SSRRR 스르륵
SITE_URL=https://www.ssrrr.net

# Publish received notification excerpts (owner opt-in).
MAIL_NOTIFICATION_PUBLISH=false

# Render-worker speech engine; install scripts/subtitle-requirements.txt in a venv.
SUBTITLE_TRANSLATION_API_URL=
SUBTITLE_TRANSLATION_API_KEY=
SUBTITLE_TRANSLATION_MODEL=gpt-4.1-mini
# Warm the model using scripts/transcribe-local.py before enabling the service.
# Only advertise subtitles when this Python executable and the cached model work.
SUBTITLE_PYTHON=
SUBTITLE_MODEL=small
